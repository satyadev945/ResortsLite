# Docker ignore file for Java Maven projects
# Excludes unnecessary files from Docker build context

# Maven build outputs
target/
!target/*.jar

# Maven wrapper (CRITICAL: Never use wrapper in Docker - use system mvn)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper (if project switches to Gradle)
gradlew
gradlew.bat
gradle/wrapper/

# IDE files
.idea/
.vscode/
.settings/
.classpath
.project
*.iml
*.iws
*.ipr

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Git
.git/
.gitignore
.gitattributes

# Documentation (not needed in container)
*.md
docs/
README*
LICENSE*

# CI/CD
.github/
.gitlab-ci.yml
Jenkinsfile
azure-pipelines.yml

# Docker files (don't copy Docker files into Docker)
Dockerfile*
docker-compose*.yml
.dockerignore

# Logs
*.log
logs/

# Test files
src/test/
test/

# Temporary files
tmp/
temp/
*.tmp
