# ─── Java / Maven build artifacts ───────────────────────────
target/
*.jar
*.war
*.ear

# ─── Maven wrapper (NEVER copy into Docker image) ────────────
mvnw
mvnw.cmd
.mvn/

# ─── Gradle wrapper (NEVER copy into Docker image) ───────────
gradlew
gradlew.bat
gradle/wrapper/
.gradle/

# ─── Version control ─────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ─── IDE / editor files ──────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
*.swp
*.swo

# ─── OS artefacts ────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Documentation ───────────────────────────────────────────
*.md
docs/

# ─── Test reports ────────────────────────────────────────────
**/surefire-reports/
**/failsafe-reports/

# ─── Docker / Kubernetes files (not needed in image) ─────────
Dockerfile*
docker-compose*.yml
.dockerignore
kubernetes/
scripts/
