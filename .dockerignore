# Java / Maven build artifacts
target/
*.jar
*.war
*.ear

# Maven wrapper (not needed inside Docker — system mvn is used)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper (not needed inside Docker — system gradle is used)
gradlew
gradlew.bat
gradle/wrapper/
.gradle/

# Git
.git/
.gitignore
.gitattributes

# IDE / editor files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# OS artefacts
.DS_Store
Thumbs.db

# Documentation
*.md
docs/

# Test reports
**/surefire-reports/
**/failsafe-reports/

# Log files
*.log
logs/

# Local config overrides
*.local
.env
.env.*

# Docker artefacts (avoid recursive copy)
Dockerfile*
docker-compose*.yml
.dockerignore

# Scripts
scripts/

# ECS manifests
ecs/
