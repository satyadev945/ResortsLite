# Java / Maven build artefacts
target/
*.jar
*.war
*.ear

# Maven wrapper (never needed inside Docker — system mvn is used)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper (not used in this project, but excluded for safety)
gradlew
gradlew.bat
gradle/wrapper/
.gradle/

# Git
.git/
.gitignore
.gitattributes

# IDE / editor files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# OS artefacts
.DS_Store
Thumbs.db

# Documentation
*.md
docs/

# Test reports
**/surefire-reports/
**/failsafe-reports/

# Logs
*.log
logs/

# Environment files (never bake secrets into the image)
.env
.env.*

# Docker artefacts (avoid recursive context)
Dockerfile*
docker-compose*.yml
.dockerignore

# Scripts (not needed at runtime)
scripts/
kubernetes/
