<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>resortsLite</artifactId>
    <version>1.0.0</version>
    <name>ResortsLite</name>
    <description>Legacy resort booking demo — Java 8 / Spring Boot 2.7.x</description>

    <properties>
        <java.version>1.8</java.version>
        <azure.storage.version>12.25.1</azure.storage.version>
        <azure.keyvault.version>4.8.7</azure.keyvault.version>
        <azure.identity.version>1.13.3</azure.identity.version>
        <!-- cr-java-0090 FIX: Spring Cloud Azure version for Azure AD / Entra ID integration -->
        <spring-cloud-azure.version>4.19.0</spring-cloud-azure.version>
        <!-- cr-java-0065 FIX: Spring Session Data Redis version aligned with Spring Boot 2.7.x BOM -->
        <spring-session-bom.version>2021.2.3</spring-session-bom.version>
        <!-- cr-java-0111 FIX: Azure Service Bus SDK version for scheduled message delivery -->
        <azure.servicebus.version>7.15.1</azure.servicebus.version>
    </properties>

    <dependencies>
        <!-- Azure Blob Storage SDK for cloud-native file storage (replaces hard-coded file paths) -->
        <dependency>
            <groupId>com.azure</groupId>
            <!-- cr-java-0069 FIX: Azure Key Vault Secrets SDK for secure credential retrieval -->
            <artifactId>azure-security-keyvault-secrets</artifactId>
            <version>${azure.keyvault.version}</version>
        </dependency>
        <!-- cr-java-0090 FIX: Spring Cloud Azure Active Directory (Entra ID) starter.
             Provides Azure AD OAuth2 / OIDC integration with Spring Security, replacing
             local file-based credential storage with centralized identity management.
             Supports both web application (authorization-code) and resource-server
             (JWT bearer token) flows backed by Microsoft Authentication Library (MSAL). -->
        <dependency>
            <groupId>com.azure.spring</groupId>
            <artifactId>spring-cloud-azure-starter-active-directory</artifactId>
            <version>${spring-cloud-azure.version}</version>
        </dependency>
        <!-- cr-java-0090 FIX: Spring Boot Security starter — required by Spring Cloud Azure AD
             to activate the Spring Security filter chain and OAuth2 resource-server support. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- cr-java-0090 FIX: Spring Security OAuth2 Resource Server — validates Azure AD
             JWT bearer tokens on every incoming request, ensuring only authenticated
             principals with valid Entra ID tokens can access protected endpoints. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <!-- cr-java-0069 FIX: Azure Identity SDK providing DefaultAzureCredential -->
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <version>${azure.identity.version}</version>
        </dependency>
        <!-- cr-java-0111 FIX: Azure Service Bus SDK — replaces java.util.Timer and server-local
             scheduling with Azure Service Bus scheduled message delivery for distributed,
             timezone-agnostic task execution across cloud instances.
             Scheduled messages use UTC OffsetDateTime, eliminating server-local timezone
             inconsistencies across multi-region deployments and container restarts. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-messaging-servicebus</artifactId>
            <version>${azure.servicebus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
            <version>${azure.storage.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- cr-java-0065 FIX: Spring Session Data Redis — externalizes HTTP session state to
             Azure Cache for Redis, enabling stateless horizontal scaling across all instances.
             The @EnableRedisHttpSession annotation in BookingController activates this store.
             Configure via SPRING_REDIS_HOST / SPRING_REDIS_PORT / SPRING_REDIS_PASSWORD /
             SPRING_REDIS_SSL environment variables pointing to your Azure Cache for Redis instance. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <!-- cr-java-0065 FIX: Spring Boot Redis starter — provides Lettuce Redis client and
             auto-configuration for connecting to Azure Cache for Redis over TLS (port 6380). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- SECURITY VIOLATION: log4j 2.14.1 has critical CVE-2021-44228 (Log4Shell) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.14.1</version>
        </dependency>
        <!-- SECURITY VIOLATION: commons-collections 3.2.1 has CVE-2015-6420 (RCE) -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.1</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
