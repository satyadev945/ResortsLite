<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>resortsLite</artifactId>
    <version>1.0.0</version>
    <name>ResortsLite</name>
    <description>Legacy resort booking demo — Java 8 / Spring Boot 2.7.x</description>

    <properties>
        <java.version>1.8</java.version>
        <!-- cr-java-0090 fix: Spring Cloud Azure BOM version for Azure AD starter -->
        <spring-cloud-azure.version>4.14.0</spring-cloud-azure.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- cr-java-0090 fix: Spring Cloud Azure BOM — manages versions for all
                 spring-cloud-azure-* artifacts including the Azure AD starter -->
            <dependency>
                <groupId>com.azure.spring</groupId>
                <artifactId>spring-cloud-azure-dependencies</artifactId>
                <version>${spring-cloud-azure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- SECURITY VIOLATION: log4j 2.14.1 has critical CVE-2021-44228 (Log4Shell) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.14.1</version>
        </dependency>
        <!-- SECURITY VIOLATION: commons-collections 3.2.1 has CVE-2015-6420 (RCE) -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.1</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Azure Blob Storage SDK: replaces hard-coded file paths (cr-java-0061) -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
            <version>12.25.1</version>
        </dependency>
        <!-- cr-java-0069 fix: Azure Key Vault Secrets SDK for retrieving DB credentials -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-security-keyvault-secrets</artifactId>
            <version>4.8.2</version>
        </dependency>
        <!-- Azure Identity SDK: provides DefaultAzureCredential (Managed Identity, env vars, CLI) -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <version>1.11.4</version>
        </dependency>
        <!-- cr-java-0065 fix: Spring Boot Redis Starter — provides RedisTemplate /
             StringRedisTemplate backed by Azure Cache for Redis, replacing in-memory
             HttpSession state storage with a distributed, cloud-native session store. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- cr-java-0065 fix: Spring Session Data Redis — transparently externalises
             HTTP session state to Azure Cache for Redis, enabling stateless horizontal
             scaling across multiple application instances without server affinity. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <!-- cr-java-0090 fix: Spring Boot Security starter — provides the Spring Security
             filter chain, SecurityContextHolder, and OAuth 2.0 / OIDC support required
        <!-- cr-java-0111 fix: Azure Service Bus SDK — replaces java.util.Timer and server-local
             scheduling with Azure Service Bus scheduled message delivery. Enables distributed,
             timezone-agnostic task execution across all cloud regions and container instances.
             ScheduleMessage API accepts OffsetDateTime in UTC, eliminating server timezone dependency. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-messaging-servicebus</artifactId>
            <version>7.15.1</version>
        </dependency>
             JWT bearer tokens on every inbound request. Replaces file-based credential
             storage with centralised, cloud-native identity management via Azure AD. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- cr-java-0090 fix: Spring Cloud Azure Active Directory starter — auto-configures
             the JwtDecoder to validate tokens issued by the Azure AD tenant specified in
             application.properties (spring.cloud.azure.active-directory.*).
             Uses MSAL (Microsoft Authentication Library) under the hood for token
             validation and principal extraction, enabling scalable, distributed
             authentication without any local credential files. -->
        <dependency>
            <groupId>com.azure.spring</groupId>
            <artifactId>spring-cloud-azure-starter-active-directory</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
